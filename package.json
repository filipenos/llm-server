{
  "name": "llm-server",
  "version": "1.0.0",
  "description": "Gateway local compatível com OpenAI para Codex, Claude e Antigravity usando logins existentes",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src test scripts README.md package.json tsconfig.json",
    "format:check": "prettier --check src test scripts README.md package.json tsconfig.json",
    "smoke": "tsx scripts/smoke.ts",
    "models": "tsx scripts/models.ts"
  },
  "keywords": [
    "llm",
    "openai-compatible",
    "codex",
    "claude",
    "gemini",
    "antigravity",
    "local-api",
    "gateway",
    "typescript"
  ],
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.286",
    "@openai/codex-sdk": "^0.159.3",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "openai": "^7.25.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filipenos/llm-server.git"
  },
  "homepage": "https://github.com/filipenos/llm-server#readme",
  "bugs": {
    "url": "https://github.com/filipenos/llm-server/issues"
  }
}
